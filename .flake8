[flake8]
max-line-length = 100
max-complexity = 10
exclude = 
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    build,
    dist,
    mlruns,
    *.egg-info,
    .tox,
    .pytest_cache

# E203: whitespace before ':' (conflicts with Black)
# W503: line break before binary operator (conflicts with Black)
# E501: line too long (handled by Black)
ignore = E203, W503, E501

per-file-ignores =
    __init__.py: F401
    test_*.py: F401, F811

# Show source code for errors
show-source = True

# Count errors
count = True

# Show statistics
statistics = True